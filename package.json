{
  "name": "dilon-zap",
  "version": "1.116.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "db:generate": "npm run db:generate -w packages/db",
    "db:push": "npm run db:push -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:studio": "npm run db:studio -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "dev:esquadrias": "npm run dev -w apps/esquadrias",
    "erp:generate": "npm run db:generate -w packages/erp-db",
    "erp:push": "npm run db:push -w packages/erp-db",
    "erp:migrate": "npm run db:migrate -w packages/erp-db",
    "erp:studio": "npm run db:studio -w packages/erp-db",
    "erp:seed": "npm run db:seed -w packages/erp-db",
    "test:core": "npm run test -w packages/esquadrias-core",
    "test:ponto": "npm run test -w packages/ponto-core",
    "test:sdr": "npm run test -w packages/ambiente-teste",
    "sdr:site": "npm run site -w packages/ambiente-teste",
    "sdr:build": "npm run build -w packages/ambiente-teste",
    "erp:deploy": "npm run db:deploy -w packages/erp-db",
    "erp:baseline": "npm run db:baseline -w packages/erp-db",
    "erp:senha": "npm run db:senha -w packages/erp-db --",
    "dev:ponto": "npm run dev -w apps/ponto",
    "ponto:generate": "npm run db:generate -w packages/ponto-db",
    "ponto:migrate": "npm run db:migrate -w packages/ponto-db",
    "ponto:deploy": "npm run db:deploy -w packages/ponto-db",
    "ponto:seed": "npm run db:seed -w packages/ponto-db",
    "ponto:studio": "npm run db:studio -w packages/ponto-db",
    "dev:vendedor-ia": "npm run start -w apps/vendedor-ia-worker",
    "test:vendedor-ia": "npm run test -w packages/vendedor-ia",
    "dev:portais": "npm run start -w apps/portais-worker",
    "test:portais": "npm run test -w packages/portais",
    "ponto:atrt": "npm run atrt -w apps/ponto --",
    "ponto:hash-inpi": "bash apps/ponto/scripts/hash-inpi.sh",
    "verificar:tenant": "tsx scripts/verificar-tenant/cli.ts",
    "test:verificar": "tsx --test scripts/verificar-tenant/verificar-tenant.test.ts",
    "verificar:tipos": "npm run typecheck -w apps/web && npm run typecheck -w apps/worker",
    "verificar": "npm run verificar:tenant && npm run test:verificar && npm run verificar:tipos"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@whiskeysockets/baileys@6.7.24": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true,
    "protobufjs@7.6.5": true
  }
}
