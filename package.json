{
  "name": "dilon-zap",
  "version": "1.10.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "db:generate": "npm run db:generate -w packages/db",
    "db:push": "npm run db:push -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:studio": "npm run db:studio -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "dev:esquadrias": "npm run dev -w apps/esquadrias",
    "erp:generate": "npm run db:generate -w packages/erp-db",
    "erp:push": "npm run db:push -w packages/erp-db",
    "erp:migrate": "npm run db:migrate -w packages/erp-db",
    "erp:studio": "npm run db:studio -w packages/erp-db",
    "erp:seed": "npm run db:seed -w packages/erp-db",
    "test:core": "npm run test -w packages/esquadrias-core",
    "erp:deploy": "npm run db:deploy -w packages/erp-db",
    "erp:baseline": "npm run db:baseline -w packages/erp-db",
    "erp:senha": "npm run db:senha -w packages/erp-db --"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@whiskeysockets/baileys@6.7.24": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true,
    "protobufjs@7.6.5": true
  }
}
