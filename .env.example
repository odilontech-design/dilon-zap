# Postgres (docker-compose local por padrão)
DATABASE_URL="postgresql://dilonzap:dilonzap@localhost:5432/dilonzap?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"

# API interna do worker — mesmo segredo dos dois lados, não precisa ser
# alcançável fora desta máquina (o worker escuta em 127.0.0.1)
WORKER_INTERNAL_URL="http://127.0.0.1:4001"
WORKER_INTERNAL_SECRET="gere-com: openssl rand -base64 24"

# Cloudflare R2 (storage de mídia) — dash.cloudflare.com > R2 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="dilon-zap-media"

# Mercado Pago — cobrança automática das mensalidades (Assinaturas /
# PreApproval), na conta MP da própria Dilon Tech. Gere em
# mercadopago.com.br > Seu negócio > Credenciais > uma aplicação do tipo
# "Assinaturas" > Credenciais de produção > Access Token.
# Sem isto, o botão "Gerar link de autorização" na ficha de cada empresa falha
# — o resto do painel funciona normalmente (cobrança manual continua igual).
MP_ACCESS_TOKEN=""

# Asaas — segunda opção de cobrança automática das mensalidades, na conta
# Asaas da própria Dilon Tech. Gere em asaas.com > Integrações > Chaves de
# API. Use a chave de SANDBOX em desenvolvimento (api-sandbox.asaas.com);
# ASAAS_ENV escolhe qual base a lib chama — "sandbox" ou "production".
# ASAAS_WEBHOOK_TOKEN é um valor aleatório seu (ex: openssl rand -base64 32),
# cadastrado também no painel da Asaas em Integrações > Webhooks > Token de
# autenticação — é o que garante que a chamada em /api/webhooks/asaas veio
# de fato da Asaas.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# ── SaaS de vidros e esquadrias (apps/esquadrias) ───────────────────────────
# Banco PRÓPRIO, separado do Dilon Zap: são dois produtos, com clientes
# diferentes. Local, o mesmo Postgres do docker-compose serve os dois — muda
# só o nome do banco.
ESQUADRIAS_DATABASE_URL="postgresql://dilonzap:dilonzap@localhost:5432/esquadrias?schema=public"
# Conexão direta, usada só pelas migrações. Em Postgres local é a mesma URL;
# em Neon/Supabase são DUAS strings diferentes (a de cima é a pooled), porque
# o PgBouncer não suporta os comandos que uma migração precisa.
ESQUADRIAS_DIRECT_URL="postgresql://dilonzap:dilonzap@localhost:5432/esquadrias?schema=public"

# ── Dilon Ponto (apps/ponto) ───────────────────────────────────────────────
# Banco PRÓPRIO, como o do Esquadrias. Local: mesmo Postgres, outro banco.
PONTO_DATABASE_URL="postgresql://dilonzap:dilonzap@localhost:5432/ponto?schema=public"
PONTO_DIRECT_URL="postgresql://dilonzap:dilonzap@localhost:5432/ponto?schema=public"
# Segredo e URL PRÓPRIOS: a sessão do Ponto não pode valer no Zap nem no Esquadrias.
# Gere com: openssl rand -base64 32
PONTO_NEXTAUTH_SECRET=""
PONTO_NEXTAUTH_URL="http://localhost:3002"
# "1" esconde a contratação pelo site (/cadastro). Vazio = contratação aberta.
PONTO_CADASTRO_FECHADO=""
# Cobrança das mensalidades: usa a MESMA conta Asaas do Zap (ASAAS_API_KEY e
# ASAAS_ENV acima). No Asaas, cadastre um SEGUNDO webhook apontando para
# https://<domínio do ponto>/api/webhooks/asaas, com este token:
PONTO_ASAAS_WEBHOOK_TOKEN=""
# Dias de prazo depois do vencimento antes de bloquear o painel (padrão 5) e
# vencimento do primeiro boleto em dias após a contratação (padrão 3).
PONTO_TOLERANCIA_DIAS="5"
PONTO_DIAS_PRIMEIRO_BOLETO="3"
# Só para testes: troca a base da API do Asaas (servidor falso). Vazio em produção.
PONTO_ASAAS_URL=""

# REP-P (Portaria MTP 671/2021). Passo a passo em docs/ponto-rh/rep-p.md.
# Desenvolvedor do programa (a Dilon Tech): sai no AFD, no AEJ e no comprovante.
PONTO_DESENVOLVEDOR_CNPJ=""
PONTO_DESENVOLVEDOR_RAZAO=""
PONTO_DESENVOLVEDOR_EMAIL=""
# Número do registro do programa no INPI (só dígitos) e o número do certificado.
PONTO_REGISTRO_INPI=""
PONTO_CERTIFICADO_INPI=""
PONTO_VERSAO_PROGRAMA="1.0"
# Certificado ICP-Brasil (e-CNPJ A1 da Dilon) que assina AFD, AEJ e comprovantes:
# o .pfx em base64 (base64 -w0 certificado.pfx) e a senha dele.
PONTO_CERT_PFX_BASE64=""
PONTO_CERT_SENHA=""
# Responsáveis que assinam o Atestado Técnico (npm run ponto:atrt), só para o script.
PONTO_RESPONSAVEL_LEGAL_NOME=""
PONTO_RESPONSAVEL_LEGAL_CPF=""
PONTO_RESPONSAVEL_TECNICO_NOME=""
PONTO_RESPONSAVEL_TECNICO_CPF=""
# Fonte da hora de referência (cabeçalho Date). Vazio = https://www.gov.br/
PONTO_REFERENCIA_HORA_URL=""

# Suporte mostrado na tela de login. Vazio esconde o botão — é o que uma
# instalação white-label deve fazer, para não exibir o contato da Dilon Tech
# aos clientes de outra empresa. Só dígitos, com código do país.
NEXT_PUBLIC_WHATSAPP_SUPORTE="5521967411481"

# Notificação no celular (Web Push) — avisa quem recebeu uma conversa
# transferida, inclusive com o sistema fechado. Gere as duas chaves de uma
# vez com:  npx web-push generate-vapid-keys
# A pública vai pro navegador (por isso NEXT_PUBLIC_); a privada assina o
# envio e nunca sai do servidor. Trocar as chaves invalida todas as
# inscrições — cada pessoa teria que permitir de novo no aparelho dela.
# Vazias: o botão some da tela e nada quebra.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@dilontech.com.br"

# --- ERP Dilon Contabilidade (produto vendido dentro do Zap) ---
# URL pública do ERP (sem barra final) e o MESMO token configurado lá em PLATAFORMA_API_TOKEN (>= 32 caracteres).
ERP_CONTABILIDADE_URL=
ERP_CONTABILIDADE_TOKEN=
# Dias de atraso tolerados antes de suspender o ERP por fatura vencida (padrão 10).
ERP_TOLERANCIA_DIAS=10
# Segredo do cron que chama POST /api/cron/erp-sync (>= 16 caracteres).
CRON_SECRET=

# Vendedor IA (apps/vendedor-ia-worker): chave da API da Anthropic. Só o worker
# do Vendedor IA usa; sem ela ele fica parado e o resto do Zap segue normal.
ANTHROPIC_API_KEY=

# Portais de anúncio (OLX). PORTAIS_CHAVE criptografa os tokens das lojas no
# banco e assina os links das fotos: 32 bytes em base64 (openssl rand -base64 32).
# Trocar a chave desconecta todas as lojas (os tokens antigos não abrem mais).
PORTAIS_CHAVE=
# Credenciais do Zap na OLX (pedidas a suporteintegrador@olxbr.com), com o
# redirecionamento https://<seu domínio>/api/portais/olx/retorno cadastrado.
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
