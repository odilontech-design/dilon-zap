# Postgres (docker-compose local por padrão)
DATABASE_URL="postgresql://dilonzap:dilonzap@localhost:5432/dilonzap?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"

# API interna do worker — mesmo segredo dos dois lados, não precisa ser
# alcançável fora desta máquina (o worker escuta em 127.0.0.1)
WORKER_INTERNAL_URL="http://127.0.0.1:4001"
WORKER_INTERNAL_SECRET="gere-com: openssl rand -base64 24"
