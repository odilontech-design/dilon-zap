generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Um Tenant = um negócio cliente da Dilon Tech (ex: Believe Cosméticos).
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  // Fuso usado pra decidir se estamos dentro do horário de atendimento. Fica
  // no tenant e não fixo no código porque quem calcula é o worker, que roda
  // em UTC dentro do container — sem isso, "18:00" viraria 15:00 pro cliente.
  timezone String @default("America/Sao_Paulo")

  // Mensagem de ausência. Vazia ou nula desliga o recurso inteiro: é o jeito
  // de a empresa que atende 24h simplesmente não configurar nada.
  outOfHoursMessage String?

  // Menu de triagem (URA) do primeiro contato. Existe pra empresa que não tem
  // ninguém lendo tudo que chega pra decidir de quem é: o próprio cliente
  // escolhe o assunto e a conversa já nasce com dono.
  //
  // Ligado/desligado explícito em vez de "tem opção cadastrada?": a empresa
  // precisa poder desligar o menu por uma semana sem apagar a configuração
  // inteira e ter que remontar depois.
  uraAtiva               Boolean @default(false)
  // Cabeçalho do menu — as opções são montadas a partir de UraOpcao e coladas
  // embaixo. Guardar o menu pronto em texto obrigaria a reescrever a mensagem
  // toda vez que uma opção mudasse de nome.
  uraMensagem            String?
  // Depois de quantos minutos sem NENHUMA mensagem (em qualquer direção)
  // o menu volta a aparecer pro cliente, mesmo que a conversa continue
  // atribuída — trata como se fosse um contato novo. O atendente que fecha
  // o atendimento manualmente antecipa isso na hora, sem esperar o tempo
  // passar. Só vale enquanto uraAtiva estiver ligado: sem menu pra
  // oferecer, reabrir a triagem não faria sentido nenhum pro cliente.
  uraReinicioAposMinutos Int     @default(60)

  // Quando uma conversa passa de um setor pra outro, o histórico do setor
  // anterior some de quem recebeu a conversa agora — só um marcador avisa
  // que houve encaminhamento. Existe pra contabilidade: o que o Departamento
  // Pessoal discutiu sobre um funcionário não é assunto do Fiscal, mesmo que
  // a conversa com o cliente continue a mesma. O Responsável pela conta
  // sempre vê tudo — a barreira é só entre setores/atendentes.
  //
  // Fica desligado por padrão: nas empresas sem essa necessidade (Believe,
  // por exemplo), transferir de setor continua levando o histórico junto,
  // como sempre foi.
  isolarHistoricoPorSetor Boolean @default(false)

  // Conversa sem responsável E sem setor (a "fila geral") aparece só pro
  // Responsável pela conta, em vez de pra todo atendente. Existe pela mesma
  // razão do isolamento de histórico: numa contabilidade, quem é do
  // Departamento Pessoal não deveria ver o assunto que chegou e ainda não foi
  // triado — e a URA, ao reabrir a triagem por inatividade, devolve a conversa
  // justamente pra essa fila, o que fazia um atendimento do Fiscal reaparecer
  // pra empresa inteira.
  //
  // Desligado por padrão: na empresa sem setores (Believe) TODA conversa está
  // nessa fila, e ligar isso deixaria o Inbox dos atendentes vazio.
  restringirFilaGeral Boolean @default(false)

  // Cabeçalho do recibo impresso. Separado de `name` de propósito: o nome
  // que a equipe vê no sistema ("Believe Cosméticos") não é o que vai no
  // comprovante — ali vai a razão social ou o nome do MEI, que é o que
  // identifica a empresa pro cliente e pro fisco.
  //
  // Tudo opcional e em texto livre. Endereço estruturado (rua, número, CEP em
  // campos) só serviria se alguém fosse consultar por CEP, e ninguém vai; em
  // texto livre a empresa escreve do jeito que quer ver impresso.
  reciboNome      String?
  reciboDocumento String?
  reciboEndereco  String?
  reciboTelefone  String?
  // Mensagem no pé do recibo: política de troca, agradecimento, Instagram.
  reciboRodape    String?
  // Largura do papel da impressora térmica, em mm. 80 é o padrão de balcão;
  // 58 é o das impressoras portáteis. Fica na empresa, e não escolhido a cada
  // impressão, porque a impressora não muda — e errar a largura corta o texto
  // ou deixa uma faixa em branco.
  reciboLarguraMm Int     @default(80)

  users             User[]
  sessions          WhatsAppSession[]
  contacts          Contact[]
  conversations     Conversation[]
  orders            Order[]
  contactBlocks     ContactBlock[]
  autoReplies       AutoReply[]
  subscription      Subscription?
  invoices          Invoice[]
  tags              Tag[]
  stages            Stage[]
  uraOpcoes         UraOpcao[]
  setores           Setor[]
  apiKeys           ApiKey[]
  recursos          TenantRecurso[]
  businessHours     BusinessHour[]
  savedTexts        SavedText[]
  scheduledMessages ScheduledMessage[]
  products          Product[]
  stockMovements    StockMovement[]
  produtoMateriais  ProdutoMaterial[]
  teamMessages      TeamMessage[]
}

// Um setor da empresa: Fiscal, Contábil, Departamento Pessoal.
//
// Existe pra que a conversa tenha dono ANTES de ter responsável. Encaminhar
// pro setor põe o atendimento numa fila que a equipe inteira do setor enxerga
// e da qual qualquer um puxa — que é o que uma pessoa só como destino não
// resolve: se ela está de férias, o cliente fica esperando e ninguém sabe.
model Setor {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nome  String
  // Etiqueta visual no Inbox. É o que faz a fila ser legível de relance,
  // sem precisar abrir a conversa pra saber de quem é o assunto.
  cor   String  @default("#0F766E")
  // Desativar em vez de apagar: setor que saiu de uso ainda é o setor das
  // conversas antigas, e apagar faria o histórico perder essa informação.
  ativo Boolean @default(true)

  createdAt DateTime @default(now())

  membros      SetorMembro[]
  opcoes       UraOpcao[]
  conversas    Conversation[]
  mensagens    Message[]
  teamMessages TeamMessage[]

  @@unique([tenantId, nome])
  @@index([tenantId, ativo])
}

// Quem pertence a qual setor.
//
// Muitos-pra-muitos de propósito: numa contabilidade pequena a mesma pessoa
// cobre Fiscal e Contábil, e obrigar a escolher um faria ela deixar de ver
// metade da fila que é dela.
model SetorMembro {
  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([setorId, userId])
  @@index([userId])
}

// Chat interno da equipe — pedido do Carlos (Guttierres): um lugar pra falar
// com o time, separado do atendimento ao cliente. Não é mais um "modelo de
// canal": um canal É um Setor. setorId nulo é o canal Geral, que todo mundo
// da empresa vê; setorId preenchido é a conversa daquele setor. Criar um
// setor novo já cria o canal dele de graça, sem cadastro duplicado.
model TeamMessage {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  setorId  String?
  setor    Setor?  @relation(fields: [setorId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("TeamMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Conversa direta 1 a 1: preenchido, a mensagem é só do autor e deste
  // destinatário (setorId fica nulo). Nulo nos dois campos = canal Geral.
  // Privada de verdade — nem o Responsável lê.
  destinatarioId String?
  destinatario   User?   @relation("TeamMessageDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)

  body String // pode ser vazio quando é só mídia, igual Message.body

  mediaType            MediaType?
  mediaKey             String? // chave do objeto no bucket R2
  mediaMimeType        String?
  mediaFileName        String?
  mediaDurationSeconds Int?

  isDeleted Boolean   @default(false) // mantém a linha (quem mandou o quê), some o conteúdo na UI
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, setorId, createdAt])
  @@index([tenantId, destinatarioId, authorId, createdAt])
}

model UraOpcao {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // O que o cliente digita. Int e não String porque a ordem do menu e a tecla
  // são a mesma coisa: "1" é a primeira opção da lista, sempre.
  ordem  Int
  rotulo String

  // Destino: EXATAMENTE um dos dois preenchido.
  //
  // Os dois existem porque as duas coisas são pedidas de verdade. A Guttierres
  // quer "1 - Fiscal", que é um setor com três pessoas. A Believe quer "3 -
  // falar com a Camila", que é uma pessoa. Um produto que só faz setor obriga
  // a revenda a criar um setor de uma pessoa só pra dizer o óbvio.
  //
  // O Postgres garantiria isso com um CHECK, mas o projeto sincroniza schema
  // com `db push`, que não conhece a restrição e a descartaria na próxima
  // sincronização em silêncio. Então quem garante é a rota /api/ura, num lugar
  // só — e este comentário existe pra que ninguém escreva um segundo caminho
  // de gravação achando que o banco protege.
  setorId     String?
  setor       Setor?  @relation(fields: [setorId], references: [id], onDelete: Cascade)
  atendenteId String?
  atendente   User?   @relation("UraDestino", fields: [atendenteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Duas opções com a mesma tecla tornariam o menu ambíguo — e a escolha do
  // cliente, uma disputa entre dois registros.
  @@unique([tenantId, ordem])
  @@index([tenantId])
}

// Chave de API de um sistema externo que fala com este tenant.
//
// Nasceu da integracao com o Dilon Saude: quando um agendamento e confirmado
// la, a confirmacao e o lembrete precisam sair pelo WhatsApp daqui. Nao e o
// segredo interno do worker (WORKER_INTERNAL_SECRET), que e do web pro worker
// e nao tem tenant: uma chave externa precisa ser revogavel sozinha e valer
// pra UMA empresa so.
//
// Guarda o HASH, nunca a chave. Quem gera ve o valor uma vez; a partir dai o
// sistema so consegue conferir, nao reexibir — que e o que impede a chave de
// vazar por um print da tela de configuracao meses depois.
model ApiKey {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Pra que serve, em texto: "Dilon Saude - producao". Sem isso, revogar vira
  // adivinhacao no dia em que houver tres chaves.
  nome  String
  hash  String @unique
  // Ultimos caracteres, so pra identificar na lista qual e qual.
  final String

  // Revogacao e data, nao exclusao: saber que uma chave existiu e quando
  // parou de valer importa quando algo estranho aparece no log.
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

// Horário de atendimento, uma linha por dia da semana. Dia sem linha é
// tratado como fechado — assim uma empresa nova não começa "aberta 24h" por
// acidente só porque ninguém configurou nada (o que desligaria a mensagem de
// ausência sem ninguém perceber).
model BusinessHour {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  weekday  Int // 0 = domingo … 6 = sábado, igual Date#getDay()
  isOpen   Boolean @default(true)
  // "HH:MM" no fuso do tenant. String e não DateTime de propósito: é hora do
  // relógio, não instante no tempo — guardar como DateTime traria uma data
  // junto e o horário passaria a "andar" com o horário de verão.
  opensAt  String  @default("08:00")
  closesAt String  @default("18:00")

  @@unique([tenantId, weekday])
}

enum UserRole {
  OWNER
  AGENT
  // Atende conversas como a consultora e, além disso, fecha pedido, altera
  // valor e mexe no estoque. Existe porque o fluxo da Believe tem essa
  // divisão de verdade — a consultora monta o pedido, o financeiro fecha —
  // e sem o papel não há como a fila do financeiro saber pra quem apontar.
  FINANCEIRO
  SUPERADMIN // Dilon Tech — acesso cross-tenant pelo painel /admin, não pertence a um tenant "cliente"
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  createdAt    DateTime @default(now())

  // Desligamento é desativação, nunca exclusão. O usuário está preso ao
  // histórico: conversas atribuídas, mensagens que ele enviou e transferências
  // que ele fez. Apagar o registro não apaga o histórico — apaga a AUTORIA
  // dele (as relações são SetNull), e a empresa perde para sempre o registro
  // de quem falou o quê com o cliente.
  //
  // Guarda a data, e não um booleano, porque "atendida pela Juliana até
  // agosto" é uma pergunta real quando se olha uma conversa antiga.
  // Nulo = ativo.
  deactivatedAt DateTime?

  // A senha foi definida por outra pessoa — no cadastro ou numa redefinição
  // feita pelo responsável — e o dono da conta ainda não trocou. Enquanto
  // for true o painel não abre e manda pra troca de senha.
  //
  // Existe porque a senha provisória é simples e circula por mensagem e em
  // reunião: sem obrigar a troca, quem a ouviu entraria na conta de outra
  // pessoa pra sempre. Padrão false de propósito: quem já usava o sistema
  // não é interrompido pela atualização.
  senhaProvisoria Boolean @default(false)

  pushSubscriptions PushSubscription[]

  assignedConversations  Conversation[]     @relation("AssignedAgent")
  transfersMade          Conversation[]     @relation("AssignedBy")
  uraOpcoes              UraOpcao[]         @relation("UraDestino")
  setores                SetorMembro[]
  sentMessages           Message[]          @relation("MessageSender")
  messageReactions       MessageReaction[]
  scheduledMessages      ScheduledMessage[] @relation("ScheduledBy")
  ordersCreated          Order[]            @relation("OrderCreatedBy")
  ordersClosed           Order[]            @relation("OrderClosedBy")
  stockMovements         StockMovement[]    @relation("StockMovementBy")
  pagamentos             Pagamento[]        @relation("PagamentoPor")
  atendimentosEncerrados Atendimento[]      @relation("AtendimentoEncerradoPor")
  teamMessages           TeamMessage[]      @relation("TeamMessageAuthor")
  teamMessagesRecebidas  TeamMessage[]      @relation("TeamMessageDestinatario")

  @@index([tenantId])
}

enum SessionStatus {
  PENDING_QR // sessão criada, aguardando o dono escanear o QR Code
  CONNECTED
  DISCONNECTED // caiu, worker vai tentar reconectar sozinho
  LOGGED_OUT // usuário deslogou pelo celular, precisa parear de novo
}

// Uma sessão = uma conexão Baileys ativa para um número de WhatsApp de um tenant.
// Fase 0: um tenant tem no máximo uma sessão. O schema já permite mais de uma
// (para quando um negócio tiver múltiplos números conectados).
model WhatsAppSession {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label           String        @default("Principal")
  phoneNumber     String? // preenchido depois de conectar, formato E.164
  status          SessionStatus @default(PENDING_QR)
  qrCode          String? // QR atual em base64 (Fase 0: worker escreve, web lê via polling)
  lastConnectedAt DateTime?
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authCreds     String?             @db.Text // credenciais Baileys (creds.json equivalente), serializado com BufferJSON
  signalKeys    WhatsAppSignalKey[]
  conversations Conversation[]
  messages      Message[]

  @@index([tenantId])
}

// Chaves de sinal (Signal Protocol) do Baileys — cada uma é uma linha própria
// em vez de um blob único, senão toda sessão vira um único JSON gigante que
// cresce sem parar e nunca dá pra limpar entrada por entrada.
model WhatsAppSignalKey {
  id        String          @id @default(cuid())
  sessionId String
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category  String // ex: "app-state-sync-key", "session", "pre-key"
  keyId     String
  value     String?         @db.Text // null = chave removida, serializado com BufferJSON
  updatedAt DateTime        @updatedAt

  @@unique([sessionId, category, keyId])
  @@index([sessionId, category])
}

// Etapa do funil de vendas — configurável por empresa (cada negócio tem seu
// próprio processo; uma agência de viagens não tem "Em separação", por
// exemplo). position define a ordem das colunas no kanban.
model Stage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#0000F5") // hex
  position  Int      @default(0)
  createdAt DateTime @default(now())

  contacts Contact[]

  @@unique([tenantId, name])
  @@index([tenantId, position])
}

// Um contato de WhatsApp dentro de um tenant (o mesmo número em tenants
// diferentes é uma linha diferente — não há dado compartilhado entre negócios).
model Contact {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waJid             String // ex: 5511999999999@s.whatsapp.net — pode ser @lid quando o WhatsApp esconde o número real
  // Nome que a tela mostra. Pode ter vindo da agenda do celular, do pushName
  // da própria pessoa, ou de alguém que digitou aqui.
  name              String?
  // Último nome que o WhatsApp nos informou pra esse contato (agenda ou
  // pushName). Não é pra exibir: serve pra saber se o nome MUDOU do lado de
  // lá. Sem isso, toda sincronização do WhatsApp parecia uma alteração nova
  // e reescrevia o `name` — inclusive por cima do que a atendente tinha
  // acabado de corrigir à mão.
  waName            String?
  // Alguém editou esse nome aqui dentro. Quando é true, sincronização do
  // WhatsApp nunca sobrescreve: quem digitou sabe melhor como a empresa
  // chama o cliente do que o nome que o cliente escolheu pra própria conta.
  nameManual        Boolean   @default(false)
  // Número de telefone real (dígitos, sem sufixo de JID) quando waJid é @lid
  // e o WhatsApp revelou o par via senderPn/jid em alguma mensagem — @lid é
  // opaco por padrão, isso só existe quando conseguimos capturar o par.
  phoneNumber       String?
  // Endereço que a tela usa. Aponta pro NOSSO servidor, não pro WhatsApp:
  // as URLs de pps.whatsapp.net expiram — metade das que tínhamos guardadas
  // já respondia 403 — e a foto sumia da tela semanas depois sem nada ter
  // mudado.
  avatarUrl         String?
  // Chave da imagem no R2. É o que a rota de avatar usa pra servir o arquivo.
  avatarKey         String?
  // Identificador da foto no WhatsApp (o nome do arquivo na URL original).
  // Coluna própria porque a reconciliação de contatos duplicados compara
  // contatos por foto: antes ela extraía isso da avatarUrl, e no dia em que
  // a avatarUrl deixasse de ser do WhatsApp a comparação pararia de casar em
  // silêncio — voltando a duplicar contato sem ninguém entender por quê.
  avatarPhotoId     String?
  // Quando a saudação de primeiro contato foi enviada pra este cliente.
  // Fica no contato e não na conversa: quem volta meses depois numa conversa
  // nova não é um contato novo, e receber "seja bem-vinda" de novo soaria
  // como se a empresa tivesse esquecido dele.
  //
  // A marca só é gravada quando a saudação SAI de fato. Se o cliente escreve
  // fora do horário, o aviso de ausência tem prioridade e a saudação fica
  // devendo — ele recebe na primeira mensagem dentro do expediente, em vez
  // de perder a boas-vindas por ter escrito de madrugada.
  saudacaoEnviadaEm DateTime?

  // Última TENTATIVA, dê certo ou não. Sem isso o worker rebuscava a foto a
  // cada mensagem recebida de todo contato sem avatar — 263 contatos batendo
  // na API do WhatsApp o dia inteiro, à toa, e esse é o tipo de padrão que
  // chama atenção no número.
  avatarCheckedAt DateTime?
  // Último Status (Stories) que esse contato postou — "tem Status disponível"
  // é calculado na hora (últimas 24h), não guardado como boolean, porque
  // Status expira sozinho e não teria como saber quando "desligar" a flag.
  lastStatusAt    DateTime?
  // null = ainda não triado no funil (aparece numa coluna "Sem etapa" à
  // parte, nunca chuta o contato pra uma etapa que possa estar errada).
  stageId         String?
  stage           Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  dealValueCents  Int       @default(0) // valor do negócio — soma no total de cada coluna do funil

  // Anotação livre sobre o cliente. Fica no CONTATO e não na conversa: o
  // que vale saber ("prefere ser chamada de Lili", "só compra no fim do
  // mês", "salão fecha segunda") vale pro próximo atendimento também, e
  // preso a um ticket resolvido isso se perderia justamente quando alguém
  // fosse mais precisar.
  notes          String?
  notesUpdatedAt DateTime?

  // Dados pro recibo impresso. O WhatsApp entrega nome e telefone e só; CPF
  // e endereço de entrega a equipe preenche quando precisa — revenda que
  // entrega e cliente que pede nota. Texto livre pelo mesmo motivo do
  // endereço da empresa: é pra imprimir, não pra consultar.
  documento String?
  endereco  String?

  // Se o número tem conta no WhatsApp. Nulo = ainda não checado — que é
  // diferente de "não tem", e a tela precisa saber a diferença pra não
  // sugerir excluir um contato que só ainda não passou pela verificação.
  //
  // Guarda a data junto porque a resposta envelhece: número pode ganhar
  // conta depois, e um "não tem" de seis meses atrás não vale como motivo
  // pra apagar ninguém.
  hasWhatsapp       Boolean?
  whatsappCheckedAt DateTime?

  // Grupo do WhatsApp (@g.us) em vez de pessoa. Mora em Contact, e não num
  // model próprio, pra reaproveitar tudo que uma conversa já tem: mídia,
  // resposta, reação, encaminhamento e a fila de envio. O custo é tirar
  // grupo das telas que são de pessoa (Inbox, contatos, funil, relatórios),
  // e é pra isso que o campo existe: filtrar pelo sufixo do JID em cada
  // consulta seria fácil de esquecer na próxima tela que alguém criar.
  grupo              Boolean             @default(false)
  // Quando a equipe ativou. Nulo = grupo só "disponível": o worker sabe que
  // ele existe mas não grava mensagem nem baixa mídia. O número costuma
  // estar em grupo de família e de fornecedor, e gravar tudo encheria a tela
  // e o armazenamento de conversa que ninguém da empresa acompanha.
  // Data, e não booleano, porque diz desde quando o grupo tem histórico aqui.
  grupoAtivadoEm     DateTime?
  // Só pra lista de grupos mostrar o tamanho. Vem junto dos dados que o
  // WhatsApp manda sobre o grupo; nunca é consultado de propósito.
  grupoParticipantes Int?
  // Membros do grupo, com telefone quando o WhatsApp informa (ver
  // GrupoParticipante). Vazio em contato que não é grupo.
  participantes      GrupoParticipante[]

  createdAt DateTime @default(now())

  conversations Conversation[]
  orders        Order[]

  @@unique([tenantId, waJid])
  @@index([tenantId])
  @@index([tenantId, stageId])
  @@index([tenantId, grupo])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

model Conversation {
  id           String             @id @default(cuid())
  ticketNumber Int                @unique @default(autoincrement()) // identificador curto pro atendente citar por telefone/e-mail
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId    String
  session      WhatsAppSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status       ConversationStatus @default(OPEN)
  tags         String[]           @default([])
  assignedToId String?
  assignedTo   User?              @relation("AssignedAgent", fields: [assignedToId], references: [id])

  // De qual setor é este atendimento. É ORTOGONAL a assignedToId, e essa é a
  // ideia toda: setor responde "de quem é o assunto", responsável responde
  // "quem está cuidando agora".
  //
  // Setor preenchido com responsável vazio É a fila do setor — o estado que a
  // equipe inteira enxerga e do qual qualquer membro puxa. Sem os dois campos
  // esse estado não existe, e encaminhar viraria de novo escolher uma pessoa.
  //
  // onDelete: SetNull porque apagar um setor não pode levar junto o histórico
  // de atendimento — a conversa aconteceu, mesmo que o setor não exista mais.
  setorId       String?
  setor         Setor?   @relation(fields: [setorId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  // Última vez que a mensagem de ausência foi mandada nesta conversa. É a
  // trava que impede o cliente levar cinco respostas iguais por mandar cinco
  // mensagens de madrugada — sem ela a automação vira motivo de reclamação.
  outOfHoursNotifiedAt DateTime?

  // Estado do menu de triagem. Fica na conversa, e não no contato como a
  // saudação, porque o que o menu resolve é de quem é ESTE atendimento.
  //
  // Na prática o cliente vê o menu uma vez: assim que ele escolhe, a conversa
  // ganha dono e a automação inteira para de rodar (ver o guard de
  // assignedToId no worker) — inclusive depois de resolvida, porque resolver
  // não tira o responsável. Quem continua sem dono é justamente quem nunca
  // escolheu, e é pra esse caso que o carimbo existe: na próxima mensagem
  // dele, o menu não é reapresentado do zero.
  uraEnviadaEm DateTime?
  // Quantas vezes o menu foi reapresentado depois de uma resposta que não é
  // opção. Vai até 1: reapresenta uma vez e, se ainda assim não vier uma
  // escolha, o robô se cala e a conversa fica na fila pra um humano assumir —
  // insistir com quem está escrevendo em texto livre é o jeito mais rápido de
  // irritar o cliente.
  uraReenvios  Int       @default(0)

  // Transferência entre atendentes. assignedAt/assignedById dizem quando e
  // por quem; assignmentSeenAt marca quando o novo responsável abriu — o
  // aviso no Inbox vive enquanto assignmentSeenAt for anterior a assignedAt.
  assignedAt       DateTime?
  assignedById     String?
  assignedBy       User?     @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignmentSeenAt DateTime?

  // Por que o atendimento acabou. Guarda o rótulo já resolvido em texto (e
  // não um id de tabela) porque o motivo é o registro histórico daquele
  // atendimento: se a empresa depois renomear ou apagar um motivo da lista,
  // as conversas antigas continuam dizendo o que de fato aconteceu.
  //
  // closedAt é separado do status: dá pra reabrir uma conversa, e aí o
  // status volta pra OPEN mas continua existindo a informação de quando e
  // por que ela tinha sido fechada da vez anterior.
  closedAt    DateTime?
  closeReason String?

  messages          Message[]
  scheduledMessages ScheduledMessage[]
  orders            Order[]
  atendimentos      Atendimento[]
  transferencias    TransferenciaSetor[]

  // Impede duas conversas pro mesmo contato na mesma sessão — sem isso, duas
  // mensagens chegando quase juntas (poucos ms de diferença) podem disparar
  // dois recordMessage() concorrentes que criam a conversa em paralelo, cada
  // um sem ver o create do outro ainda (find-then-create não é atômico).
  @@unique([contactId, sessionId])
  @@index([tenantId, status])
  // Fila do setor: quem sao as conversas do meu setor sem responsavel.
  @@index([tenantId, setorId, assignedToId])
  @@index([sessionId])
}

// Lista de opt-out por tenant — contato que pediu pra não receber mais
// mensagem. Consultada tanto pelo worker (nunca manda outbound pra quem tá
// aqui) quanto pelas Campanhas na Fase 2.
// Um ciclo de atendimento dentro de uma conversa: abriu, foi atendido, fechou.
//
// A conversa e uma so por contato e dura pra sempre; o ATENDIMENTO tem comeco
// e fim, e a mesma pessoa volta meses depois com outro assunto. Sem isto, o
// historico e uma parede unica de mensagens sem saber onde um assunto acabou
// e outro comecou — e Conversation.closedAt guarda so o ULTIMO, porque reabrir
// limpa o carimbo.
//
// Gravado no FECHAMENTO, nao na abertura: o inicio e o fim do ciclo anterior
// (ou a criacao da conversa, no primeiro). Assim nao existe ciclo aberto pra
// manter em dia, e nao ha caminho onde alguem esqueca de abrir um.
model Atendimento {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  iniciadoEm  DateTime
  encerradoEm DateTime
  // Rotulo em texto, nao id de tabela: e o registro historico daquele
  // atendimento. Se a empresa renomear ou apagar um motivo da lista, os
  // atendimentos antigos continuam dizendo o que de fato aconteceu.
  motivo      String?

  encerradoById String?
  encerradoPor  User?   @relation("AtendimentoEncerradoPor", fields: [encerradoById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([conversationId, encerradoEm])
}

model ContactBlock {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waJid     String
  reason    String?
  createdAt DateTime @default(now())

  // Se além de esconder da caixa, o número foi bloqueado na conta do
  // WhatsApp de verdade. São coisas diferentes: bloquear aqui é reversível e
  // invisível pro cliente; bloquear lá corta o contato com a empresa inteira
  // e aparece no celular de quem estiver com o aparelho.
  //
  // Guardado pra saber o que desfazer no desbloqueio — desbloquear na conta
  // um número que nunca foi bloqueado lá seria mexer no WhatsApp da empresa
  // sem ninguém ter pedido.
  blockedOnWhatsApp Boolean @default(false)

  @@unique([tenantId, waJid])
  @@index([tenantId])
}

// v1 do "construtor de fluxos": resposta automática disparada por palavra-chave
// (substring, case-insensitive) quando a conversa ainda não tem atendente
// atribuído. isDefault = usada quando nenhuma palavra-chave bate.
model AutoReply {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyword    String
  response   String
  isDefault  Boolean  @default(false)
  // Saudação de primeiro contato: dispara sem palavra-chave, uma vez por
  // cliente, quando ele fala com a empresa pela primeira vez.
  //
  // É diferente da resposta padrão, e a diferença é o ponto: a padrão
  // responde a TODA mensagem que não casa palavra-chave, então usá-la como
  // boas-vindas mandaria a mesma saudação pro mesmo cliente pra sempre.
  isGreeting Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// Etiqueta cadastrada pelo tenant (nome + cor) — Conversation.tags continua
// sendo String[] guardando o NOME da etiqueta, não uma FK, de propósito:
// os tenants já têm tags em texto livre em produção, e criar uma relação
// de verdade exigiria migrar esse histórico. Isso aqui só define a lista
// "oficial" com cor/status pra alimentar o seletor — uma conversa marcada
// com um nome que não está mais aqui (etiqueta apagada/renomeada) continua
// mostrando o texto puro, sem quebrar nada.
// Catálogo de produtos com preço de tabela.
//
// Preço em centavos (Int), nunca Float: 19.90 não existe exato em ponto
// flutuante, e somar dez itens assim rende total com centavo a mais ou a
// menos. Num pedido isso vira divergência com o que o cliente pagou.
//
// NÃO tem estoque de propósito. Estoque não é um número no produto — é o
// saldo de um histórico de movimentações (entrou, vendeu, devolveu,
// perdeu). Um campo "quantidade" que alguém edita na mão parece resolver e
// desanda em duas semanas: some do sistema o que saiu pela porta, e aí
// ninguém confia mais no número. Se a Believe precisar, é módulo próprio.
enum TipoItem {
  PRODUTO
  SERVICO
}

model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String

  // Produto ou serviço. A diferença que importa é UMA: serviço não tem
  // estoque. Não é "estoque infinito" nem "estoque zero" — é que a pergunta
  // não se aplica, e tratar como número faria uma consultoria aparecer como
  // "sem estoque" na tela de venda.
  //
  // Enum e não booleano porque a lista pode crescer (assinatura, por exemplo,
  // que é serviço mas recorrente) e `isService = false` não teria pra onde ir.
  //
  // O default PRODUTO mantém os 52 itens da Believe exatamente como estão.
  tipo TipoItem @default(PRODUTO)

  // Quanto tempo o serviço ocupa, em minutos. Só faz sentido pra SERVICO, e é
  // o campo que uma agenda consome pra saber onde cabe. Nulo em produto, e
  // nulo também em serviço que a empresa não quis medir.
  duracaoMinutos Int?
  // Código interno da Believe, quando existir. Opcional porque nem todo
  // produto tem, e exigir um código inventado só pra cadastrar é atrito.
  sku            String?
  categoria      String?
  priceCents     Int

  // Descrição detalhada do serviço, pra equipe usar no atendimento (o
  // atendente copia pra conversa e ajusta). Separada do nome porque é texto
  // longo — protocolo, indicação, cuidados — que não cabe numa listagem.
  descricao String?
  // Desativado some dos seletores de pedido mas continua no histórico: um
  // produto que saiu de linha ainda aparece nos pedidos antigos, e apagar
  // faria o pedido antigo perder o que foi vendido.
  isActive  Boolean @default(true)

  // Saldo atual, mantido em cache.
  //
  // A verdade é a soma de StockMovement — este campo existe só pra listar
  // 300 produtos sem fazer 300 somas. Por isso NUNCA é escrito direto: toda
  // alteração passa por registrarMovimento(), que grava a movimentação e
  // atualiza o saldo na MESMA transação. Se alguém escrever aqui por fora,
  // o cache descola do histórico e o número deixa de valer.
  stockQty Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements  StockMovement[]
  orderItems OrderItem[]
  materiais  ProdutoMaterial[]

  @@unique([tenantId, name])
  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
}

enum OrderStatus {
  RASCUNHO // a consultora está montando
  AGUARDANDO_FINANCEIRO // passou adiante, esperando valor e condição
  FECHADO // financeiro fechou — é aqui que o estoque baixa
  CANCELADO
}

enum PaymentMethod {
  PIX
  CARTAO // maquininha, presencial ou por link — o Dilon Zap só registra
  BOLETO
  FIADO
}

// Pedido de venda, nascido dentro da conversa.
//
// O fluxo da Believe tem duas mãos: a consultora monta o pedido a partir do
// que foi conversado e passa pro financeiro, que coloca valor e condição e
// fecha. O status é essa passagem — não é enfeite.
model Order {
  id       String @id @default(cuid())
  // Número curto pra citar por telefone e pra imprimir. Mesmo papel do
  // ticketNumber da conversa.
  numero   Int    @unique @default(autoincrement())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // De qual conversa nasceu. Opcional porque um pedido pode ser criado
  // direto da ficha do cliente, sem conversa aberta.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  status OrderStatus @default(RASCUNHO)

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedById  String?
  closedBy    User?   @relation("OrderClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  paymentMethod PaymentMethod?
  // Separado do status: pedido fiado ou por boleto FECHA sem estar pago. Sem
  // essa distinção não dá pra saber quanto a empresa tem a receber.
  //
  // É CACHE, igual ao saldo do estoque: a verdade é a soma de Pagamento, e
  // este campo existe pra listar cem pedidos sem fazer cem somas. Por isso
  // nunca é escrito direto — só por registrarPagamento(), que grava o
  // pagamento e atualiza isto na MESMA transação. Escrever por fora descola
  // o cache do histórico e o número deixa de valer.
  pago          Boolean        @default(false)
  pagoEm        DateTime?

  // Quando o cliente combinou de pagar.
  //
  // Sem isto não existe "vencido": `pago` sozinho responde se recebeu, nunca
  // se está atrasado — e "quem me deve há mais tempo" é a única pergunta que
  // importa numa lista de recebíveis. Nulo em pedido pago na hora (PIX,
  // cartão), onde combinar prazo não faz sentido.
  vencimento DateTime?

  pagamentos Pagamento[]

  // Totais congelados no fechamento, em centavos. Recalcular a partir dos
  // itens em toda leitura pareceria mais "correto", mas um item editado
  // depois mudaria o valor de um pedido já fechado — o total tem que ser o
  // que foi combinado, não o que as contas dariam hoje.
  subtotalCents Int @default(0)
  descontoCents Int @default(0)
  totalCents    Int @default(0)

  observacao String?

  enviadoAoFinanceiroEm DateTime?
  fechadoEm             DateTime?
  canceladoEm           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Último dia em que o acompanhamento interno de cobrança avisou o
  // financeiro sobre este pedido (ver precisaLembrarHoje em
  // packages/receivables). Só marca o dia, não a mensagem — o mesmo pedido
  // pode gerar avisos em datas diferentes (2 dias antes, no vencimento, a
  // cada 7 dias depois), e este campo existe só pra não avisar duas vezes
  // no mesmo dia se o ciclo rodar mais de uma vez.
  ultimoLembreteInternoEm DateTime?

  items OrderItem[]

  @@index([tenantId, status, createdAt])
  @@index([contactId])
  @@index([conversationId])
}

// Um recebimento de um pedido.
//
// Historico, e nao um booleano — mesma escolha do StockMovement e pelo mesmo
// motivo. Fiado de cosmetico se paga em parcela: "pagou 60 de 200" nao cabe
// em sim/nao, e um campo "valorPago" que alguem edita na mao desanda em duas
// semanas (some do sistema o que entrou pelo caixa e ninguem sabe quando nem
// de quem). Com o historico da pra responder "por que o saldo era 200 e agora
// e 140", que e a pergunta que aparece quando o numero nao bate.
//
// Nunca e apagado nem editado: estorno e um pagamento NEGATIVO, nao a
// correcao do anterior. Reescrever o passado e o que faz o extrato perder a
// serventia.
model Pagamento {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Em centavos. Negativo e estorno — o unico caso em que a soma diminui.
  valorCents Int
  meio       PaymentMethod?

  // Quando o dinheiro entrou, que nem sempre e quando foi lancado: a
  // consultora recebe no sabado e registra na segunda, e o relatorio tem que
  // dizer sabado.
  recebidoEm DateTime @default(now())
  observacao String?

  createdById String?
  createdBy   User?   @relation("PagamentoPor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Nome COPIADO do catálogo no momento em que o item entrou. Se o produto
  // for renomeado ou desativado depois, o pedido antigo continua dizendo o
  // que de fato foi vendido — apontar só pro catálogo faria o histórico
  // mudar sozinho quando alguém arruma um cadastro.
  nomeProduto String

  // Preço de tabela na hora, e o efetivamente praticado. Guardar os dois é o
  // que permite responder "quanto de desconto foi dado" — com só o praticado
  // essa informação não existe, e não dá pra reconstituir depois.
  precoTabelaCents Int
  precoUnitCents   Int
  quantidade       Int

  @@index([orderId])
}

enum StockMovementType {
  COMPRA // entrada: chegou do fornecedor
  PRODUCAO // entrada: a Believe montou/produziu
  DEVOLUCAO // entrada: cliente devolveu
  AJUSTE // acerto de inventário — único que pode ser pra cima ou pra baixo
  VENDA // saída: saiu num pedido
}

// Histórico de tudo que mexeu no estoque.
//
// Estoque é isto, não um número: o saldo é a soma daqui. Um campo
// "quantidade" que alguém edita na mão parece resolver e desanda em duas
// semanas — some do sistema o que saiu pela porta e ninguém sabe quando nem
// por quê. Com o histórico dá pra responder "por que tinha 40 e agora tem
// 12", que é a pergunta que aparece quando o número não bate.
//
// Nunca é apagado nem editado: acerto de estoque é uma movimentação nova de
// AJUSTE, não uma correção da anterior. Reescrever o passado é justamente o
// que faz o histórico perder a serventia.
model StockMovement {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  tipo       StockMovementType
  // Positivo entra, negativo sai. AJUSTE aceita os dois sinais; os demais
  // têm sinal fixo pelo tipo, e isso é garantido em lib/stock.
  quantidade Int
  motivo     String?

  // Saldo depois desta movimentação. Guardado pra dar pra auditar a linha do
  // tempo sem recalcular tudo, e pra flagrar divergência: se o saldo
  // registrado aqui não bate com a soma até este ponto, alguém escreveu por
  // fora.
  saldoDepois Int

  createdById String?
  createdBy   User?    @relation("StockMovementBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId, productId, createdAt])
  @@index([productId, createdAt])
}

enum ScheduledMessageStatus {
  PENDING // esperando a hora
  SENT // já entrou na fila de saída
  CANCELLED // a atendente desmarcou
  HELD // a hora chegou mas o cliente escreveu antes — esperando decisão
}

// Mensagem marcada pra sair depois. Nasceu do pós-venda ("lembrar de
// perguntar como foi em 7 dias"), mas serve pra qualquer coisa com hora
// marcada.
//
// Quando a hora chega, o worker NÃO envia direto: ele cria uma Message
// normal na fila de saída. Assim o agendamento herda de graça tudo que o
// envio já sabe fazer — respeitar bloqueio, vestir o nome do atendente,
// registrar no histórico, reenviar se o cliente não conseguir decifrar.
// Um caminho de envio paralelo seria um segundo lugar pra esquecer regra.
model ScheduledMessage {
  id             String                 @id @default(cuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body           String
  scheduledFor   DateTime
  status         ScheduledMessageStatus @default(PENDING)

  // Quem marcou. É esse nome que vai no prefixo quando a mensagem sair —
  // pro cliente, quem falou com ele foi uma pessoa, não "o sistema".
  createdById String?
  createdBy   User?   @relation("ScheduledBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Preenchido quando vira mensagem de verdade, pra dar pra achar o que saiu.
  messageId String?

  // Marco pra decidir se o cliente escreveu depois do agendamento. Guardado
  // no momento em que a atendente marca, e não lido da conversa na hora do
  // envio, porque o que interessa é "aconteceu algo NOVO desde que eu
  // programei isso" — e a última mensagem da conversa muda o tempo todo.
  lastInboundAtOnSchedule DateTime?
  heldAt                  DateTime?
  sentAt                  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, status, scheduledFor])
  @@index([conversationId])
}

// Textos guardados pra reusar: resposta rápida ("Bom dia! Como posso
// ajudar?") e script de abordagem de venda ou cobrança.
//
// Um model só pros dois de propósito. Por baixo são a mesma coisa — texto
// reutilizável, organizado por assunto — e o que muda é só o tamanho e a hora
// de usar. Dois sistemas separados dariam dois lugares pra procurar texto, e
// nenhum dos dois ficaria completo: no segundo dia de uso alguém ia querer
// inserir um trecho do script na conversa, e aí teria que copiar de uma tela
// pra outra.
//
// `categoria` é texto livre em vez de tabela própria: a Believe vai querer
// "Financeiro", "Objeção de preço", "Pós-venda", e obrigar a cadastrar
// categoria antes de escrever o primeiro texto é atrito sem retorno. A tela
// sugere as que já existem.
model SavedText {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria String
  titulo    String
  corpo     String
  // Atalho opcional pra chamar pelo teclado (ex: "bomdia"). Nulo quando não
  // tem — em Postgres o unique convive com vários nulos, então quem não usa
  // atalho não colide com ninguém.
  atalho    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, titulo])
  @@unique([tenantId, atalho])
  @@index([tenantId, categoria])
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#0000F5") // hex
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING // outbound, ainda não enviada pelo worker
  SENT
  DELIVERED
  READ
  FAILED
}

enum MediaType {
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sessionId       String
  session         WhatsAppSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction       MessageDirection
  status          MessageStatus    @default(SENT)
  // Quando o status mudou pela última vez. Sem isso não dava pra responder
  // "essa mensagem está parada em SENT há quanto tempo?" — que é a diferença
  // entre um recibo que ainda vai chegar e um que nunca vem.
  statusUpdatedAt DateTime?
  body            String // legenda/texto — pode ser vazio quando é só mídia
  // Id da mensagem no WhatsApp. É por ele que os recibos de entrega e leitura
  // encontram a mensagem — por isso ele é GERADO POR NÓS e gravado ANTES do
  // envio. Quando era o WhatsApp que gerava, ele só existia aqui depois do
  // sendMessage resolver, e todo recibo que chegasse nessa janela procurava
  // um id que ainda não estava no banco e era descartado calado.
  waMessageId     String?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  readAt          DateTime? // null = não lida ainda no dashboard (só importa pra INBOUND)

  // Quem mandou (OUTBOUND enviada por um atendente pelo Inbox) — null pra
  // auto-resposta, histórico importado e tudo que é INBOUND. O worker usa
  // isso pra prefixar o nome na mensagem de verdade mandada ao WhatsApp.
  senderUserId String?
  sender       User?   @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  // Quem mandou, numa mensagem de GRUPO. Num chat 1:1 o autor é o próprio
  // contato e isto fica nulo; no grupo o contato é o grupo, e sem o autor
  // em cada mensagem a tela não teria como dizer quem falou. Foi o defeito
  // dos grupos gravados antes de 03/08: o grupo inteiro aparecia com o nome
  // de quem mandou a primeira mensagem.
  //
  // O nome é retrato do momento (pushName), igual a nomeProduto no pedido:
  // quem troca o nome da conta depois não reescreve o que já disse.
  // autorJid é o participante exatamente como o WhatsApp mandou, e é o que
  // responder e reagir a essa mensagem precisam pra achá-la dentro do grupo.
  autorJid  String?
  autorNome String?

  // Setor da conversa NO MOMENTO em que esta mensagem foi trocada — não o
  // setor atual dela. É essa foto que permite esconder o histórico de um
  // setor do próximo que receber a conversa (ver Tenant.isolarHistoricoPorSetor)
  // sem precisar reconstruir uma linha do tempo de transferências toda vez
  // que alguém abre a conversa. Nulo = trocada antes de ir pra algum setor
  // (fila geral), e por isso nunca fica escondida — não tem de quem esconder.
  setorId String?
  setor   Setor?  @relation(fields: [setorId], references: [id], onDelete: SetNull)

  mediaType            MediaType?
  mediaKey             String? // chave do objeto no bucket R2
  mediaMimeType        String?
  mediaFileName        String? // nome original, relevante pra DOCUMENT
  mediaDurationSeconds Int? // relevante pra AUDIO e VIDEO

  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false) // "apagar pra todos" — mantém a linha (auditoria), esconde o conteúdo na UI
  deletedAt DateTime?

  // Só o rótulo visual "Encaminhada" — sem referência à mensagem original
  // (igual WhatsApp, que também não guarda esse vínculo).
  isForwarded Boolean @default(false)

  // O aparelho do cliente não conseguiu decifrar esta mensagem e pediu
  // reenvio. Falha de decifragem é inerente ao Signal com múltiplos
  // dispositivos (o WhatsApp oficial também sofre) — por isso o protocolo tem
  // reenvio. O que não pode acontecer é a falha ser invisível: a mensagem
  // consta ENTREGUE e até LIDA, porque o recibo é do envelope, não do
  // conteúdo. Sem registrar aqui, ninguém descobre até o cliente reclamar.
  retryRequestedAt DateTime?
  // Conseguimos reenviar (buscamos o original no banco e devolvemos pro
  // Baileys recifrar). Pedido sem entrega servida = a atendente precisa
  // reenviar na mão, e o Inbox avisa.
  retryServedAt    DateTime?

  // Resposta citando outra mensagem da mesma conversa — WhatsApp não permite
  // citar mensagem de outra conversa, então não precisa reforçar isso aqui.
  quotedMessageId String?
  quotedMessage   Message?  @relation("MessageReply", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy        Message[] @relation("MessageReply")

  reactions MessageReaction[]

  // Evita duplicar a mesma mensagem do WhatsApp quando ela chega mais de uma
  // vez (retry de rede, reconexão) quase ao mesmo tempo — mesmo motivo do
  // unique de Conversation: find-then-create não é atômico, upsert é. NULL
  // não conflita com NULL no Postgres, então mensagens sem waMessageId
  // (auto-resposta antiga etc.) não são afetadas.
  @@unique([conversationId, waMessageId])
  @@index([conversationId, createdAt])
  @@index([sessionId, status]) // worker consulta PENDING por sessão
  @@index([conversationId, direction, readAt]) // contagem de não lidas
}

// Reação (emoji) numa mensagem — igual ao "curtir"/reagir do WhatsApp. Como
// aqui só existem chats 1:1 (sem grupo), só há duas identidades possíveis
// reagindo a uma mensagem: a empresa (fromMe=true) e o contato (fromMe=false)
// — por isso a unicidade é [messageId, fromMe], não por usuário.
model MessageReaction {
  id            String   @id @default(cuid())
  messageId     String
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fromMe        Boolean // true = reação da empresa, false = reação do contato
  emoji         String
  // Atendente que reagiu pelo Inbox — só preenchido quando a reação partiu
  // do sistema (não quando alguém reagiu direto pelo celular, e nunca
  // quando fromMe=false).
  reactorUserId String?
  reactorUser   User?    @relation(fields: [reactorUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([messageId, fromMe])
}

// Trilha de auditoria pro painel /admin da Dilon Tech. Sem @relation de
// propósito: campos denormalizados (snapshot de nome/e-mail/tenant no
// momento da ação) pra o registro sobreviver a edição/exclusão do
// usuário/tenant e não exigir join pra exibir a lista.
model AuditLog {
  id               String   @id @default(cuid())
  actorUserId      String
  actorName        String
  actorEmail       String
  actorTenantId    String
  targetTenantId   String // igual a actorTenantId pra ação normal; diferente quando super-admin age sobre outro tenant
  targetTenantName String
  action           String // ex: "login", "contact.create", "whatsapp.connect", "tenant.create"
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([targetTenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

enum BillingStatus {
  // Teste gratuito. O site promete 14 dias; sem este estado, a empresa em
  // teste era indistinguível de uma que paga — e ninguém sabia quando cobrar.
  TRIAL
  ACTIVE
  PAUSED
  CANCELED
}

// Os planos que a Dilon Tech vende. Preço NÃO mora aqui: é "a partir de" e
// negociado por cliente (fica em Subscription.amountCents). O plano define o
// que o sistema faz valer — limite de atendentes e quais recursos vêm ligados.
enum Plano {
  ESSENCIAL
  PROFISSIONAL
  ESCALA
}

// Recursos que um plano pode incluir ou não.
//
// Só entra aqui o que o sistema consegue de fato ligar e desligar. Inbox,
// contatos, funil e relatórios ficam fora de propósito: são o produto em si,
// e esconder relatório atrapalha justamente a renovação — é onde o cliente vê
// o valor que está recebendo.
enum Recurso {
  URA
  SETORES
  PEDIDOS
  CONTAS_RECEBER
  INTEGRACAO_API
  GRUPOS
  // Biblioteca de materiais dos produtos (descrição, documentos, vídeos).
  // Também libera o catálogo de Produtos sem precisar do fluxo de Pedidos —
  // a Hemoderi usa o catálogo pra mandar material, não pra vender pelo chat.
  MATERIAIS
}

// Plano de cada cliente — preço negociado individualmente (não tem
// catálogo fixo de planos), um por tenant. Cobrança automática via cartão de
// crédito (Mercado Pago Assinaturas) é opcional por tenant — quem não tem
// mpPreapprovalId continua no controle manual pelo painel /admin (boleto/PIX).
model Subscription {
  id          String        @id @default(cuid())
  tenantId    String        @unique
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountCents Int
  cycleDay    Int // dia do mês em que vence a próxima fatura (1-28)
  status      BillingStatus @default(ACTIVE)
  notes       String?

  plano Plano @default(ESSENCIAL)

  // Cliente da regra antiga: contratou quando todo plano tinha a plataforma
  // completa, e é assim que continua. É uma promessa comercial por escrito —
  // está no site e na proposta enviada à Hemoderi — e não pode ser desfeita
  // por uma mudança de tabela.
  //
  // Um campo explícito, e não uma pilha de exceções por recurso: exceções
  // soltas pareceriam arbitrárias a quem abrisse o cadastro daqui a um ano.
  // Este diz o motivo.
  //
  // DEFAULT TRUE, e isso é o que protege os clientes atuais. Quando o
  // `db push` acrescenta esta coluna, toda assinatura que JÁ existe recebe o
  // default. Com false, a Believe e a Guttierres cairiam pra Essencial sem
  // módulo nenhum no instante do deploy — a Believe perderia Pedidos no meio
  // do expediente. Com true, as linhas antigas herdam a regra antiga sozinhas,
  // sem script de migração e sem janela entre o schema e o código.
  //
  // Quem entra a partir de agora recebe false EXPLICITAMENTE no código
  // (criação de empresa no admin). O default só vale pro que já existia —
  // e se algum caminho futuro esquecer de passar o valor, erra pro lado de
  // dar mais, que numa promessa comercial é o lado seguro.
  plataformaCompleta Boolean @default(true)

  // Fim do teste gratuito. Só tem sentido com status TRIAL.
  testeAte DateTime?

  // Taxa de implantação: cobrança única, diferente da mensalidade. O site
  // anuncia R$ 597 e às vezes isenta — por isso o valor fica registrado, e não
  // fixo no código.
  setupCents  Int?
  setupPagoEm DateTime?

  // Quando e por que saiu. Sem isto, "cancelado" é um estado sem história: não
  // dá pra saber se o cliente saiu por preço, por falta de uso ou porque
  // fechou a empresa — e são três conversas completamente diferentes.
  canceladoEm        DateTime?
  motivoCancelamento String?

  // Cobrança automática via Mercado Pago (Assinaturas / PreApproval). Estes
  // três campos ficam vazios enquanto a empresa paga por boleto/PIX avulso
  // gerado manualmente — as duas formas convivem, nada aqui obriga migrar.
  mpPreapprovalId     String? // id da assinatura no Mercado Pago, gerado ao criar o link
  // Cache do último status que o Mercado Pago informou (pending, authorized,
  // paused, cancelled) — evita bater na API deles só pra desenhar a tela.
  // Fonte da verdade real é sempre o webhook; isto é só o que sabíamos por
  // último.
  mpPreapprovalStatus String?
  // E-mail pro qual a assinatura é criada no Mercado Pago (o pagador). Pode
  // ser diferente do e-mail de nenhum usuário do tenant — quem paga às vezes
  // não é quem usa o sistema.
  billingEmail        String?

  // Cobrança automática via Asaas — segunda opção ao lado do Mercado Pago,
  // pro cliente que prefere boleto/PIX recorrente em vez de cartão só. Mesma
  // lógica de cache: fonte da verdade é o webhook, isto é só o que sabíamos
  // por último.
  asaasCustomerId         String?
  asaasSubscriptionId     String?
  asaasSubscriptionStatus String?
  // CPF/CNPJ de quem paga — a Asaas EXIGE isso pra cadastrar o cliente (o
  // Mercado Pago não pede). Fica junto de billingEmail porque os dois
  // descrevem a mesma pessoa: quem paga, não necessariamente quem usa.
  billingDocument         String?

  // Pix Automático — terceira opção de cobrança, ao lado do Mercado Pago e
  // do cartão da própria Asaas. É uma API separada da Subscription de cartão
  // (ver lib/asaas.ts): o pagador autoriza escaneando um QR code no PRÓPRIO
  // banco dele, não numa página de checkout nossa, e a partir daí a Asaas
  // debita via PIX sozinha todo mês.
  asaasPixAuthorizationId     String?
  asaasPixAuthorizationStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
}

// Exceção de recurso para uma empresa específica.
//
// O efetivo é: padrão do plano, com isto por cima. Serve pra ligar um recurso
// que o plano não inclui (um cliente em teste de um módulo, a integração só
// pra quem tem o Dilon Saúde) ou desligar um que ele inclui (uma empresa que
// não quer Pedidos poluindo o menu da equipe).
model TenantRecurso {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurso   Recurso
  ativo     Boolean
  // Pra que ninguém tenha que adivinhar daqui a seis meses por que esta
  // empresa tem um recurso fora do plano.
  motivo    String?
  updatedAt DateTime @updatedAt

  @@id([tenantId, recurso])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

// Uma cobrança de um ciclo. Nasce de dois jeitos: manual pelo painel
// ("+ Gerar próxima cobrança", fica PENDING até alguém marcar como paga) ou
// automática pelo webhook do Mercado Pago quando a assinatura cobra o cartão
// sozinha (nasce já PAID, com mpPaymentId preenchido). status OVERDUE é
// calculado on-the-fly (ver lib/billing.ts) a partir de PENDING + dueDate
// vencida, não escrito direto.
model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountCents    Int
  dueDate        DateTime
  status         InvoiceStatus @default(PENDING)
  paidAt         DateTime?
  // @unique é o que impede duplicar a fatura se o Mercado Pago reenviar o
  // mesmo webhook (eles reenviam de propósito até receberem 200 — é normal).
  mpPaymentId    String?       @unique
  // Mesma ideia do mpPaymentId, pro lado da Asaas — impede duplicar a
  // fatura se o webhook reenviar o mesmo evento (a Asaas também reenvia até
  // receber 200).
  asaasPaymentId String?       @unique
  createdAt      DateTime      @default(now())

  @@index([tenantId, dueDate])
  @@index([subscriptionId, dueDate])
  @@index([status])
}

/// Cada vez que uma conversa troca de setor, com o motivo escrito por quem
/// encaminhou.
///
/// Existe por causa do isolamento de histórico (ver
/// Tenant.isolarHistoricoPorSetor): o setor que recebe não enxerga o que foi
/// conversado antes, então precisa de alguém dizendo do que se trata. Sem o
/// motivo, a conversa chega muda na fila e o cliente tem que repetir tudo.
///
/// Nomes de setor gravados como foto, e não por relação: o registro é o que
/// aconteceu naquele dia, e continua legível mesmo que o setor seja renomeado
/// ou desativado depois.
model TransferenciaSetor {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  deSetorNome   String?
  paraSetorId   String?
  paraSetorNome String?

  /// O que o setor que recebe precisa saber. Obrigatório na transferência
  /// feita à mão; quando o setor muda junto com a atribuição a uma pessoa, o
  /// sistema escreve sozinho.
  motivo   String
  porNome  String?
  criadoEm DateTime @default(now())

  @@index([conversationId, criadoEm])
}

/// Um aparelho que aceitou receber notificação do Dilon Zap.
///
/// Uma linha por APARELHO, não por pessoa: quem usa no computador e no
/// celular quer ser avisado nos dois. O endpoint é a URL que o navegador dá
/// pra gente empurrar a notificação, e é único por instalação — por isso ele
/// serve de chave: reinstalou o app, vira outro endpoint, e o antigo morre
/// sozinho (o serviço de push passa a responder 410, e a gente apaga).
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  /// Chaves da criptografia ponta a ponta do push: o navegador gera, e sem
  /// elas o serviço de push recusa a mensagem. Não são segredo nosso — são
  /// específicas daquele aparelho.
  p256dh   String
  auth     String

  /// Pra saber qual aparelho é qual quando alguém tiver vários.
  userAgent String?
  criadoEm  DateTime @default(now())

  @@index([userId])
}

/// Um membro de um grupo do WhatsApp, com o telefone quando o WhatsApp informa.
///
/// Existe porque a mensagem de grupo chega com o autor em @lid — um
/// identificador anônimo, sem relação com o número. Na Hemoderi, 100% das
/// mensagens de grupo chegaram assim, e a equipe precisa do telefone pra
/// chamar o profissional no privado. Quem entrega o número é a consulta dos
/// dados do grupo (groupMetadata), que traz o par @lid ↔ telefone de cada
/// membro.
///
/// É uma foto da última consulta, não a verdade ao vivo: quem sair do grupo
/// continua aqui até alguém atualizar. Por isso a tela mostra a data.
model GrupoParticipante {
  id      String  @id @default(cuid())
  grupoId String
  grupo   Contact @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  /// Como o WhatsApp identifica a pessoa no grupo (@lid ou @s.whatsapp.net).
  jid      String
  /// O @lid, quando conhecido — é por ele que a mensagem aponta o autor.
  lid      String?
  /// Só dígitos. Nulo quando o grupo esconde os números (comunidade).
  telefone String?
  admin    Boolean @default(false)

  atualizadoEm DateTime @updatedAt

  @@unique([grupoId, jid])
  @@index([grupoId, lid])
}

/// Um arquivo da biblioteca de um produto: termo de consentimento, ficha de
/// anamnese, protocolo, vídeo explicativo do serviço.
///
/// Pedido da Hemoderi (reunião 21/09): a equipe manda esses arquivos pro
/// cliente o dia inteiro e hoje procura cada um no celular. Aqui fica um
/// lugar só, e a conversa tem um botão pra mandar.
///
/// O arquivo mora no armazenamento (R2) pela mediaKey e é reaproveitado a
/// cada envio — nada é copiado. Por isso tirar da biblioteca NÃO apaga o
/// arquivo: as mensagens que já foram com ele continuam precisando dele pra
/// abrir na conversa.
model ProdutoMaterial {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  titulo          String
  mediaKey        String
  mediaType       MediaType
  mimeType        String
  fileName        String
  tamanhoBytes    Int
  /// Só vídeo. A Hemoderi combinou vídeos de até 90s.
  duracaoSegundos Int?

  criadoEm DateTime @default(now())

  @@index([productId])
  @@index([tenantId])
}
