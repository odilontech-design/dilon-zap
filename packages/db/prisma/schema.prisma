generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Um Tenant = um negócio cliente da Dilon Tech (ex: Believe Cosméticos).
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users         User[]
  sessions      WhatsAppSession[]
  contacts      Contact[]
  conversations Conversation[]
  contactBlocks ContactBlock[]
  autoReplies   AutoReply[]
  subscription  Subscription?
  invoices      Invoice[]
}

enum UserRole {
  OWNER
  AGENT
  SUPERADMIN // Dilon Tech — acesso cross-tenant pelo painel /admin, não pertence a um tenant "cliente"
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  createdAt    DateTime @default(now())

  assignedConversations Conversation[] @relation("AssignedAgent")

  @@index([tenantId])
}

enum SessionStatus {
  PENDING_QR   // sessão criada, aguardando o dono escanear o QR Code
  CONNECTED
  DISCONNECTED // caiu, worker vai tentar reconectar sozinho
  LOGGED_OUT   // usuário deslogou pelo celular, precisa parear de novo
}

// Uma sessão = uma conexão Baileys ativa para um número de WhatsApp de um tenant.
// Fase 0: um tenant tem no máximo uma sessão. O schema já permite mais de uma
// (para quando um negócio tiver múltiplos números conectados).
model WhatsAppSession {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label         String        @default("Principal")
  phoneNumber   String? // preenchido depois de conectar, formato E.164
  status        SessionStatus @default(PENDING_QR)
  qrCode        String? // QR atual em base64 (Fase 0: worker escreve, web lê via polling)
  lastConnectedAt DateTime?
  lastError     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authCreds String? @db.Text // credenciais Baileys (creds.json equivalente), serializado com BufferJSON
  signalKeys WhatsAppSignalKey[]
  conversations Conversation[]
  messages      Message[]

  @@index([tenantId])
}

// Chaves de sinal (Signal Protocol) do Baileys — cada uma é uma linha própria
// em vez de um blob único, senão toda sessão vira um único JSON gigante que
// cresce sem parar e nunca dá pra limpar entrada por entrada.
model WhatsAppSignalKey {
  id        String          @id @default(cuid())
  sessionId String
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category  String // ex: "app-state-sync-key", "session", "pre-key"
  keyId     String
  value     String?         @db.Text // null = chave removida, serializado com BufferJSON
  updatedAt DateTime        @updatedAt

  @@unique([sessionId, category, keyId])
  @@index([sessionId, category])
}

enum PipelineStage {
  NOVO_LEAD
  EM_CONTATO
  PROPOSTA_ENVIADA
  FECHADO
  PERDIDO
}

// Um contato de WhatsApp dentro de um tenant (o mesmo número em tenants
// diferentes é uma linha diferente — não há dado compartilhado entre negócios).
model Contact {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waJid       String // ex: 5511999999999@s.whatsapp.net — pode ser @lid quando o WhatsApp esconde o número real
  name        String?
  // Número de telefone real (dígitos, sem sufixo de JID) quando waJid é @lid
  // e o WhatsApp revelou o par via senderPn/jid em alguma mensagem — @lid é
  // opaco por padrão, isso só existe quando conseguimos capturar o par.
  phoneNumber String?
  avatarUrl   String? // URL da foto de perfil do WhatsApp, quando disponível/pública
  pipelineStage PipelineStage @default(NOVO_LEAD)
  createdAt   DateTime      @default(now())

  conversations Conversation[]

  @@unique([tenantId, waJid])
  @@index([tenantId])
  @@index([tenantId, pipelineStage])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

model Conversation {
  id        String              @id @default(cuid())
  ticketNumber Int              @unique @default(autoincrement()) // identificador curto pro atendente citar por telefone/e-mail
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String
  session   WhatsAppSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status    ConversationStatus  @default(OPEN)
  tags      String[]            @default([])
  assignedToId String?
  assignedTo   User?            @relation("AssignedAgent", fields: [assignedToId], references: [id])
  lastMessageAt DateTime        @default(now())
  createdAt DateTime            @default(now())

  messages Message[]

  @@index([tenantId, status])
  @@index([sessionId])
}

// Lista de opt-out por tenant — contato que pediu pra não receber mais
// mensagem. Consultada tanto pelo worker (nunca manda outbound pra quem tá
// aqui) quanto pelas Campanhas na Fase 2.
model ContactBlock {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waJid     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([tenantId, waJid])
  @@index([tenantId])
}

// v1 do "construtor de fluxos": resposta automática disparada por palavra-chave
// (substring, case-insensitive) quando a conversa ainda não tem atendente
// atribuído. isDefault = usada quando nenhuma palavra-chave bate.
model AutoReply {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyword   String
  response  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING   // outbound, ainda não enviada pelo worker
  SENT
  DELIVERED
  READ
  FAILED
}

enum MediaType {
  AUDIO
  IMAGE
  DOCUMENT
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sessionId      String
  session        WhatsAppSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  status         MessageStatus     @default(SENT)
  body           String // legenda/texto — pode ser vazio quando é só mídia
  waMessageId    String? // id da mensagem no WhatsApp, útil para status de entrega
  errorMessage   String?
  createdAt      DateTime          @default(now())
  readAt         DateTime? // null = não lida ainda no dashboard (só importa pra INBOUND)

  mediaType         MediaType?
  mediaKey          String?  // chave do objeto no bucket R2
  mediaMimeType     String?
  mediaFileName     String?  // nome original, relevante pra DOCUMENT
  mediaDurationSeconds Int?  // relevante pra AUDIO

  @@index([conversationId, createdAt])
  @@index([sessionId, status]) // worker consulta PENDING por sessão
  @@index([conversationId, direction, readAt]) // contagem de não lidas
}

// Trilha de auditoria pro painel /admin da Dilon Tech. Sem @relation de
// propósito: campos denormalizados (snapshot de nome/e-mail/tenant no
// momento da ação) pra o registro sobreviver a edição/exclusão do
// usuário/tenant e não exigir join pra exibir a lista.
model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  actorName      String
  actorEmail     String
  actorTenantId  String
  targetTenantId String // igual a actorTenantId pra ação normal; diferente quando super-admin age sobre outro tenant
  targetTenantName String
  action         String // ex: "login", "contact.create", "whatsapp.connect", "tenant.create"
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([targetTenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

enum BillingStatus {
  ACTIVE
  PAUSED
  CANCELED
}

// Plano de cada cliente — preço negociado individualmente (não tem
// catálogo fixo de planos), um por tenant. Cobrança automática via
// Mercado Pago é um passo futuro (mpPreapprovalId fica pronto pra isso);
// por ora o controle é manual pelo painel /admin.
model Subscription {
  id              String        @id @default(cuid())
  tenantId        String        @unique
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountCents     Int
  cycleDay        Int // dia do mês em que vence a próxima fatura (1-28)
  status          BillingStatus @default(ACTIVE)
  notes           String?
  mpPreapprovalId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoices Invoice[]
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

// Uma cobrança de um ciclo — gerada manualmente pelo painel por enquanto
// ("+ Gerar próxima cobrança"). status OVERDUE é calculado on-the-fly (ver
// lib/billing.ts) a partir de PENDING + dueDate vencida, não escrito direto.
model Invoice {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountCents    Int
  dueDate        DateTime
  status         InvoiceStatus @default(PENDING)
  paidAt         DateTime?
  mpPaymentId    String?
  createdAt      DateTime     @default(now())

  @@index([tenantId, dueDate])
  @@index([subscriptionId, dueDate])
  @@index([status])
}
