# .env de produção (na VM, não no git) — reusa o MESMO Postgres (Neon) e
# storage (R2) que já estão em uso, só muda o que depende de rodar em
# containers Docker separados em vez de processos no mesmo host.

# Postgres (Neon) — mesma DATABASE_URL do ambiente local
DATABASE_URL="postgresql://..."

# NextAuth — domínio real, com https
NEXTAUTH_URL="https://zap.dilontech.com.br"
NEXTAUTH_SECRET="mesma chave do ambiente local, ou gere uma nova com: openssl rand -base64 32"

# API interna do worker — em Docker, web e worker são hosts diferentes na
# rede do compose, então usa o nome do serviço em vez de 127.0.0.1, e o
# worker precisa escutar em 0.0.0.0 pra aceitar conexão de outro container
# (a porta não é publicada pro host/internet, então continua privada)
WORKER_INTERNAL_URL="http://worker:4001"
WORKER_INTERNAL_HOST="0.0.0.0"
WORKER_INTERNAL_SECRET="mesma chave do ambiente local, ou gere uma nova"

# Cloudflare R2 — mesmas credenciais do ambiente local
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="dilon-zap-media"

# ── SaaS de vidros e esquadrias (apps/esquadrias) ───────────────────────────
# Banco PRÓPRIO no mesmo Postgres. Crie uma vez com:
#   docker compose -f docker-compose.prod.yml exec postgres \
#     psql -U "$POSTGRES_USER" -c "CREATE DATABASE esquadrias"
ESQUADRIAS_DATABASE_URL="postgresql://USUARIO:SENHA@postgres:5432/esquadrias?schema=public"
# No Postgres do compose é a mesma URL. Em banco gerenciado (Neon), esta é a
# conexão DIRETA e a de cima é a POOLED — ver docs/deploy-vercel-neon.md.
ESQUADRIAS_DIRECT_URL="postgresql://USUARIO:SENHA@postgres:5432/esquadrias?schema=public"

# Domínio e segredo PRÓPRIOS — não reaproveite os do Zap. São dois produtos:
# o NEXTAUTH_URL acima aponta pro domínio do Zap, e um segredo compartilhado
# faria um cookie de sessão de um produto ser aceito pelo outro.
# Gere com: openssl rand -base64 32
ESQUADRIAS_NEXTAUTH_URL="https://esquadrias.dilontech.com.br"
ESQUADRIAS_NEXTAUTH_SECRET=""

# Suporte mostrado na tela de login. Vazio esconde o botão — é o que uma
# instalação white-label deve fazer, para não exibir o contato da Dilon Tech
# aos clientes de outra empresa. Só dígitos, com código do país.
NEXT_PUBLIC_WHATSAPP_SUPORTE="5521967411481"
